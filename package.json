{
  "name": "dealer-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "db:reset": "tsx --env-file=.env.local scripts/reset.ts && npm run db:migrate && npm run db:seed && npm run db:demo-users",
    "samples": "tsx --env-file=.env.local scripts/make-sample-exports.ts",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:demo-users": "tsx --env-file=.env.local scripts/seed-users.ts",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "next": "15.5.28",
    "pg-boss": "^12.38.0",
    "postgres": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
