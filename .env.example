# Copy this file to .env.local and adjust if your database runs elsewhere.
# The app connects as the restricted role (row-level security on):
DATABASE_URL=postgres://dd_app:dd_app@localhost:5432/dealer_dashboard
# Migrations and the sample-data generator connect as the owner:
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/dealer_dashboard

# Password for the demo logins created by `npm run db:demo-users` (choose your own; never commit it)
DEMO_PASSWORD=
